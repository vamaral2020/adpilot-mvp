# Development only. Never commit a real .env.
DB_NAME=adpilot
DB_USER=adpilot
DB_PASSWORD=replace-with-strong-local-password
ADPILOT_ADMIN_USERNAME=admin
ADPILOT_ADMIN_PASSWORD=replace-with-at-least-12-chars
META_GRAPH_VERSION=v26.0
# Optional: configure locally after Meta access is granted.
META_AD_ACCOUNT_ID=
META_ACCESS_TOKEN=
# Nuvemshop app OAuth (create app in Partners Portal; read_products + read_orders).
# Do not commit real secrets. Key: openssl rand -base64 32
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=
NUVEMSHOP_REDIRECT_URI=
NUVEMSHOP_USER_AGENT=
NUVEMSHOP_ENCRYPTION_KEY=
# Optional trusted overrides for local mock-server integration tests:
# NUVEMSHOP_API_BASE=https://api.nuvemshop.com.br
# NUVEMSHOP_API_VERSION=2025-03
# NUVEMSHOP_OAUTH_BASE=https://www.nuvemshop.com.br
# NUVEMSHOP_TOKEN_URL=https://www.tiendanube.com/apps/authorize/token
# NUVEMSHOP_DASHBOARD_URL=http://localhost:13000/
